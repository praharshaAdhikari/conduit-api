# Copy to .env. These values match docker-compose.yml and are for local use only.
PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:4100

DB_HOST=127.0.0.1
DB_PORT=4306
DB_USER=conduit
DB_PASSWORD=conduit
DB_NAME=conduit

# Any long random string. Tokens signed with one secret are rejected under another.
JWT_SECRET=change-me-local-only
JWT_EXPIRES_IN=7d

# Where the web app is: customers are sent back there after paying.
WEB_URL=http://localhost:4100

# "fake" is the payment provider built into this API: it needs no account and
# no network. "stripe" uses Stripe test mode and needs the two keys below.
PAYMENT_PROVIDER=fake
# Signs the fake provider's webhooks. Any string.
FAKE_PAY_WEBHOOK_SECRET=fake-pay-local-secret
# From the Stripe dashboard (test mode) and from `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
